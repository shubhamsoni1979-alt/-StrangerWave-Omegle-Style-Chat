# Server
PORT=3001
NODE_ENV=development

# CORS - must match the URL the frontend is served from
FRONTEND_URL=http://localhost:3000

# WebRTC TURN server (recommended for production - STUN alone fails on many
# corporate/mobile NATs). Leave blank to fall back to STUN-only.
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# Matchmaking / abuse controls
MAX_MESSAGE_LENGTH=500
MAX_MESSAGES_PER_10S=15
MAX_FIND_PARTNER_PER_10S=10
QUEUE_MATCH_INTERVAL_MS=500
STALE_SOCKET_TIMEOUT_MS=30000
